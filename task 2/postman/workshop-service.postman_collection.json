{
  "info": {
    "name": "Task 2 - Workshop Registration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "notifierUrl",
      "value": "http://localhost:8002"
    },
    {
      "key": "workshopId",
      "value": "1"
    },
    {
      "key": "memberId",
      "value": "1"
    },
    {
      "key": "outboxId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Create member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha\",\n  \"email\": \"asha@campus.edu\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Workshops",
      "item": [
        {
          "name": "Create workshop",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workshops",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend Basics\",\n  \"startsAt\": \"2026-11-20T10:00:00Z\",\n  \"capacity\": 30\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('workshopId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List workshops",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workshops",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops"
              ]
            }
          }
        },
        {
          "name": "Get workshop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workshops/{{workshopId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops",
                "{{workshopId}}"
              ]
            }
          }
        },
        {
          "name": "Register member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workshops/{{workshopId}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops",
                "{{workshopId}}",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberId\": {{memberId}}\n}"
            }
          }
        },
        {
          "name": "List registrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workshops/{{workshopId}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops",
                "{{workshopId}}",
                "registrations"
              ]
            }
          }
        },
        {
          "name": "Cancel workshop",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/workshops/{{workshopId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workshops",
                "{{workshopId}}",
                "cancel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Outbox",
      "item": [
        {
          "name": "List outbox for workshop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/outbox?workshopId={{workshopId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "outbox"
              ],
              "query": [
                {
                  "key": "workshopId",
                  "value": "{{workshopId}}"
                }
              ]
            }
          }
        },
        {
          "name": "List pending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/outbox?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "outbox"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "List dead",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/outbox?status=dead",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "outbox"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "dead"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  \"const items = pm.response.json().items;\",\n  \"if (items.length) { pm.collectionVariables.set('outboxId', items[0].id); }\"\n]"
            }
          }
        },
        {
          "name": "Retry dead row",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/outbox/{{outboxId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "outbox",
                "{{outboxId}}",
                "retry"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Mock notifier",
      "item": [
        {
          "name": "Deliveries for workshop",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notifierUrl}}/deliveries?workshopId={{workshopId}}",
              "host": [
                "{{notifierUrl}}"
              ],
              "path": [
                "deliveries"
              ],
              "query": [
                {
                  "key": "workshopId",
                  "value": "{{workshopId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Notifier stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notifierUrl}}/stats",
              "host": [
                "{{notifierUrl}}"
              ],
              "path": [
                "stats"
              ]
            }
          }
        },
        {
          "name": "Take notifier down",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{notifierUrl}}/admin/config",
              "host": [
                "{{notifierUrl}}"
              ],
              "path": [
                "admin",
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            }
          }
        },
        {
          "name": "Bring notifier up, flaky",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{notifierUrl}}/admin/config",
              "host": [
                "{{notifierUrl}}"
              ],
              "path": [
                "admin",
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false,\n  \"failureRate\": 0.5,\n  \"timeoutRate\": 0.1\n}"
            }
          }
        },
        {
          "name": "Force next reply to time out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{notifierUrl}}/admin/config",
              "host": [
                "{{notifierUrl}}"
              ],
              "path": [
                "admin",
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeoutNext\": 1\n}"
            }
          }
        }
      ]
    }
  ]
}